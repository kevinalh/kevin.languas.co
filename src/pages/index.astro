---
import { Image } from "astro:assets";
import type { Person, ProfilePage, WithContext } from "schema-dts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import RecentlyListening from "@/components/RecentlyListening.astro";
import RecentlyStarred from "@/components/RecentlyStarred.astro";
import { Content as Bio } from "@/content/bio.md";
import { getPageData } from "@/lib/data";
import { EMAIL, profileLinks } from "@/lib/links";
import { DESCRIPTION as description, NAME, ROLE } from "@/lib/site";

const avatarPicture = "https://avatars.githubusercontent.com/u/3322228";
const { topAlbums, repositories } = await getPageData();

const person: Person = {
  "@type": "Person",
  name: NAME,
  url: Astro.site?.href,
  description,
  jobTitle: ROLE,
  address: {
    "@type": "PostalAddress",
    addressLocality: "London",
    addressCountry: "GB",
  },
  nationality: { "@type": "Country", name: "Peru" },
  knowsAbout: [
    "Distributed systems",
    "ClickHouse",
    "Analytical databases",
    "Data engineering",
    "Kubernetes",
    "Rust",
    "Go",
    "Python",
    "Mathematics",
  ],
  worksFor: {
    "@type": "Organization",
    name: "Cloudflare",
    url: "https://www.cloudflare.com",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Pontifical Catholic University of Peru",
      alternateName: ["Pontificia Universidad Católica del Perú", "PUCP"],
      sameAs:
        "https://en.wikipedia.org/wiki/Pontifical_Catholic_University_of_Peru",
    },
  ],
  image: avatarPicture,
  email: `mailto:${EMAIL}`,
  givenName: "Kevin",
  familyName: "Languasco",
  sameAs: [
    ...profileLinks.map((link) => link.href),
    "https://stackoverflow.com/users/2616577/kevin-languasco/",
  ],
};

// Google reads ProfilePage as a profile result. dateModified is left out
// because it should only change on human edits, not on the scheduled rebuilds.
const ldSchema: WithContext<ProfilePage> = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: Astro.site?.href,
  // The site's first commit.
  dateCreated: "2021-09-18T15:27:58-05:00",
  mainEntity: person,
};
---

<BaseLayout
  title={`${NAME} · ${ROLE}`}
  description={description}
  keywords="distributed systems, ClickHouse, analytical databases, data engineering, Kubernetes, Rust, Go, Cloudflare"
  ogType="profile"
  image={{
    // Rendered by scripts/og-image.mjs.
    src: "/og.png",
    alt: `${NAME}, ${ROLE} at Cloudflare in London`,
    width: 1200,
    height: 630,
  }}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(ldSchema)}
  />
  <link slot="head" rel="alternate" type="text/markdown" href="/index.md" />

  <div
    class="mx-5 mt-10 max-w-[1000px] sm:mx-[50px] sm:mt-20 md:mx-[100px] md:mt-[45px]"
  >
    <div class="text-center md:text-left">
      <Image
        src={avatarPicture}
        width={200}
        height={200}
        densities={[1, 2]}
        quality={70}
        alt="Kevin Languasco"
        loading="eager"
        fetchpriority="high"
        class="mx-auto rounded-full ring-4 ring-line md:mx-0"
      />
      <div class="my-10"></div>
      <h1 class="text-3xl font-bold">Hi! I&apos;m Kevin.</h1>
    </div>
    <div class="my-5"></div>
    <div
      class="flex flex-col gap-3 text-[1.2em] sm:text-[1.5em] [&_a]:link"
    >
      <Bio />
    </div>
    {topAlbums && <RecentlyListening albums={topAlbums} />}
    {repositories && <RecentlyStarred repositories={repositories} />}
    <Footer />
  </div>
</BaseLayout>
