---
import { Image } from "astro:assets";
import type { Person, WithContext } from "schema-dts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import RecentlyListening from "@/components/RecentlyListening.astro";
import RecentlyStarred from "@/components/RecentlyStarred.astro";
import { getStarredRepositories } from "@/lib/github";
import { getTopAlbums } from "@/lib/lastfm";
import { EMAIL, profileLinks } from "@/lib/links";

const bioFontSize = "text-[1.2em] sm:text-[1.5em]";
const linkClass = "text-accent hover:underline";
const avatarPicture = "https://avatars.githubusercontent.com/u/3322228";
const description =
  "Kevin Languasco is a Distributed Systems Engineer at Cloudflare, working on the Analytical Database Platform.";
const [topAlbums, repositories] = await Promise.all([
  getTopAlbums(),
  getStarredRepositories(),
]);

const ldSchema: WithContext<Person> = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Kevin Languasco",
  url: "https://kevin.languas.co",
  description,
  jobTitle: "Distributed Systems Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Cloudflare",
    url: "https://www.cloudflare.com",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Pontifical Catholic University of Peru",
      sameAs:
        "https://en.wikipedia.org/wiki/Pontifical_Catholic_University_of_Peru",
    },
  ],
  image: avatarPicture,
  email: `mailto:${EMAIL}`,
  givenName: "Kevin",
  sameAs: [
    ...profileLinks.map((link) => link.href),
    "https://stackoverflow.com/users/2616577/kevin-languasco/",
  ],
};
---

<BaseLayout
  title="Kevin Languasco"
  description={description}
  keywords="distributed systems, analytical databases, data engineering, Cloudflare, Kevin Languasco"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(ldSchema)}
  />

  <div
    class="mx-5 mt-10 max-w-[1000px] sm:mx-[50px] sm:mt-20 md:mx-[100px] md:mt-[45px]"
  >
    <div class="text-center md:text-left">
      <Image
        src={avatarPicture}
        width={200}
        height={200}
        alt="Kevin Languasco"
        loading="eager"
        class="mx-auto rounded-full md:mx-0"
      />
      <div class="my-10"></div>
      <h1 class="text-3xl font-bold">Hi! I&apos;m Kevin.</h1>
    </div>
    <div class="my-5"></div>
    <div class="flex flex-col gap-3">
      <p class={bioFontSize}>
        I&apos;m a Peruvian engineer currently working at <a
          class={linkClass}
          href="https://www.haystack.tv/about-us">Haystack News</a
        >, a streaming news app for cord cutters with millions of users.
      </p>
      <p class={bioFontSize}>
        I previously worked at <a
          class={linkClass}
          href="https://www.lapositiva.com.pe/wps/portal/corporativo/home"
          >La Positiva Seguros</a
        >, an insurance company, and got a Bachelors in Mathematics from the <a
          class={linkClass}
          href="https://www.pucp.edu.pe/">Pontifical Catholic University of Peru</a
        >, doing an exchange semester at the <a
          class={linkClass}
          href="https://www.ou.edu/">University of Oklahoma</a
        > and taking PhD-level classes in the Summer Program of the <a
          class={linkClass}
          href="https://impa.br/"
          >Institute of Pure and Applied Mathematics (IMPA)</a
        > in Rio de Janeiro.
      </p>
      <p class={bioFontSize}>
        I&apos;m passionate about learning new things, no matter the field. For
        pretty much my whole life I&apos;ve been interested in music (a new
        obscure music genre I can casually bring up in a conversation? Yes
        please!), computer stuff (OK but <i>how</i> does WiFi actually encode data
        in the air?) and <a
          class={linkClass}
          href="https://plato.stanford.edu/entries/platonism-mathematics/"
          >philosophy</a
        >.
      </p>
      <p class={bioFontSize}>
        My programming language journey can be summarized as follows: I&apos;m
        the Python guy who was happy to leave the complexities of C++ behind,
        only to end up using type hinting everywhere after a few years. Now
        I&apos;m in the process of getting comfortable with Scala and Rust to get
        the full experience of a strict type system. On the way, learned some
        TypeScript too.
      </p>
    </div>
    {topAlbums && topAlbums.length > 0 && <RecentlyListening albums={topAlbums} />}
    {
      repositories && repositories.length > 0 && (
        <RecentlyStarred repositories={repositories} />
      )
    }
    <Footer />
  </div>
</BaseLayout>
