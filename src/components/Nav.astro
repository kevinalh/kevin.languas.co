---
const navItems = [{ label: "GitHub Stars", href: "/github" }];
---

<header class="border-b border-gray-200 bg-white text-gray-600">
  <div class="mx-auto flex min-h-[60px] items-center gap-10 px-4">
    <a href="/" class="font-semibold text-gray-800">Kevin L</a>
    <nav class="flex items-center gap-4">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium transition-colors hover:text-gray-800"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
