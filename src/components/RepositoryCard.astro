---
import type { StarredRepository } from "@/lib/types";

interface Props {
  repository: StarredRepository;
}

const { repository } = Astro.props;
const { node } = repository;
---

<article class="w-4/5 rounded-md border border-gray-200 p-5 shadow-md">
  <h2 class="text-lg font-semibold">
    <a
      href={node.url}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:underline"
    >
      {node.nameWithOwner}
    </a>
  </h2>
  <div class="flex items-stretch">
    <p class="mr-auto max-w-[60%] sm:max-w-[80%]">{node.description}</p>
    <div class="relative mr-auto h-20 w-20">
      <img
        src={node.openGraphImageUrl}
        alt={node.name}
        width="80"
        height="80"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
  <div class="flex items-center gap-2">
    <span
      class="inline-block h-4 w-4 rounded-full"
      style={node.primaryLanguage?.color
        ? `background-color: ${node.primaryLanguage.color}`
        : ""}
    ></span>
    <span>{node.primaryLanguage?.name}</span>
    <svg
      viewBox="0 0 24 24"
      class="h-4 w-4 fill-current"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
      ></path>
    </svg>
    <span>{node.stargazerCount}</span>
  </div>
</article>
