---
import { EMAIL, profileLinks } from "@/lib/links";

// The page is rebuilt whenever its data is refreshed, so the build time is
// when the Last.fm and GitHub sections were last fetched.
const builtAt = new Date().toISOString();
// ISO 8601 date and time to the minute, e.g. "2026-10-25 12:58".
const builtAtLabel = `${builtAt.slice(0, 10)} ${builtAt.slice(11, 16)}`;
---

<footer
  class="mt-16 flex flex-col gap-3 border-t border-line py-6 text-sm text-subtle sm:flex-row sm:items-baseline"
>
  <ul class="flex flex-wrap gap-x-5 gap-y-2">
    {
      profileLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-fg hover:underline"
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a href={`mailto:${EMAIL}`} class="hover:text-fg hover:underline"
        >Email</a
      >
    </li>
  </ul>
  <p class="text-xs sm:ml-auto">
    Last updated <time datetime={builtAt}>{builtAtLabel} UTC</time>
  </p>
</footer>
