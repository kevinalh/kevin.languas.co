---
import {
  formatPlays,
  formatStats,
  LASTFM_PROFILE_URL,
  type ListeningStats,
  type TopAlbum,
} from "@/lib/lastfm";

interface Props {
  albums: TopAlbum[];
  stats: ListeningStats | null;
}

const { albums, stats } = Astro.props;
---

<section class="mt-12">
  <h2 class="text-2xl font-bold">Recently listening</h2>
  <p class="mt-1 text-sm text-subtle">
    My most played albums this week, via <a
      class="link"
      href={LASTFM_PROFILE_URL}
      target="_blank"
      rel="noopener noreferrer">Last.fm</a
    >.{stats && ` ${formatStats(stats)}.`}
  </p>
  <ol class="mt-4 divide-y divide-line">
    {
      albums.map((album, index) => (
        <li class="flex items-baseline gap-3 py-2">
          <span class="w-5 shrink-0 text-right text-sm text-faint tabular-nums">
            {index + 1}
          </span>
          <a
            href={album.wikipediaUrl ?? album.url}
            target="_blank"
            rel="noopener noreferrer"
            class="min-w-0 flex-1 truncate hover:underline"
          >
            <span class="font-semibold">{album.name}</span>
            <span class="text-muted"> · {album.artist}</span>
          </a>
          <span class="shrink-0 text-xs text-subtle tabular-nums">
            {formatPlays(album.playcount)}
          </span>
          {
            album.spotifyUrl ? (
              <a
                href={album.spotifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-4 shrink-0 text-center text-xs text-subtle hover:text-accent"
                title="Listen on Spotify"
                aria-label={`Listen to ${album.name} on Spotify`}
              >
                {/* U+FE0E keeps the triangle from rendering as an emoji. */}
                ▶&#xFE0E;
              </a>
            ) : (
              <span class="w-4 shrink-0" />
            )
          }
        </li>
      ))
    }
  </ol>
</section>
