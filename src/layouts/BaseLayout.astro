---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  /** Open Graph type of the page, e.g. "profile" for the homepage. */
  ogType?: string;
  /** Absolute URL of the image shown in link previews. */
  image?: { src: string; alt: string };
}

const { title, description, keywords, ogType = "website", image } = Astro.props;
// With `build.format: "file"` the pathname ends in `.html`; strip it so the
// canonical URL matches the extensionless URL Cloudflare serves.
const pathname = Astro.url.pathname
  .replace(/(^|\/)index\.html$/, "$1")
  .replace(/\.html$/, "");
const canonical = new URL(pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#edf1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2e3440" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kevin Languasco" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image.src} />}
    {image && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@kevinalh" />
    <slot name="head" />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
